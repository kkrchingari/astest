# OPENROUTER_API_KEY: Required for AI analysis, vetting, and translation.
OPENROUTER_API_KEY=""

# GEMINI_API_KEY: Used as a fallback for AI queries when OpenRouter is unavailable.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MongoDB Connection String
MONGODB_URI=""

# JWT Secret for Authentication
JWT_SECRET="super-secret-astro-key"

# Frontend API URL
VITE_API_URL=""
